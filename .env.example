# 此文件只说明云端所需的环境变量；不要把真实密钥提交到 Git。
# 正式部署时写入 /etc/job-tracer/job-tracer.env，由 systemd 读取。

NODE_ENV=production
PORT=3210

# PostgreSQL 仅监听 127.0.0.1；密码请替换为随机强密码。
DATABASE_URL=postgresql://job_tracer:change-me@127.0.0.1:5432/job_tracer
DATABASE_MAX_CONNECTIONS=8
DATABASE_IDLE_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=8
DATABASE_SSL=false

# 会话 Cookie：生产环境必须通过 HTTPS 提供服务，并保持 true。
SESSION_TTL_DAYS=7
SESSION_COOKIE_SECURE=true

# 可选：服务器私有文件目录与邮箱授权码主密钥目录。若不填，分别使用项目 data/ 和 ~/.job-tracer。
# JOB_TRACER_DATA_DIR=/var/lib/job-tracer/data
# JOB_TRACER_KEY_DIR=/var/lib/job-tracer/keys
